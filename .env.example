# Existing SEO behavior: staging only; production may remain unset.
APP_ENV=
# Public container ID; optional analytics fails closed when blank/invalid. See docs/analytics/PHASE_16D.md.
NEXT_PUBLIC_GTM_ID=
# Future auth URL, not the public canonical source. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: required solely by the protected health reader; never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Ref of this environment plus BOTH distinct remote refs for isolation checks.
SUPABASE_PROJECT_REF=
SUPABASE_STAGING_PROJECT_REF=
SUPABASE_PRODUCTION_PROJECT_REF=
# Local/operator tools only; never needed by a Vercel build.
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
# Resend: placeholders only; no email is sent in Phase 3A.
RESEND_API_KEY=
TRANSACTIONAL_FROM=Adam’s Work <notifications@adamswork.app>
PUBLIC_REPLY_TO=adamfiik13@gmail.com
# Server-only error capture; no replay/tracing or browser DSN in Phase 3A.
SENTRY_DSN=
# Generate a unique random secret of at least 32 characters per environment.
CRON_SECRET=
